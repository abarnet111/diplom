filebeat.inputs:
- type: filestream
  enabled: true
  id: nginx-access
  paths:
    - /var/log/nginx/access.log
  fields:
    log_type: nginx-access
  parsers:
    - ndjson:
        target: ""

- type: filestream
  enabled: true
  id: nginx-error
  paths:
    - /var/log/nginx/error.log
  fields:
    log_type: nginx-error
  parsers:
    - ndjson:
        target: ""

output.elasticsearch:
  hosts: ["{{ elasticsearch_host }}:9200"]

setup.kibana:
  host: "{{ kibana_host }}:5601"

processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  - add_cloud_metadata: ~
  - add_docker_metadata: ~
  - add_kubernetes_metadata: ~
